#!/usr/bin/env python3
"""Watch Hyprland events for the Themis panel's dismiss signal.

The curation page cannot reach the compositor, so pressing Escape with
nothing open appends " · dismiss" to its title for a moment (app.js). This
daemon watches the compositor's event socket for that marker and puts the
panel away. The hide is performed natively rather than through
themis-inbox.sh: the script's bash+python startup added ~500ms between
Escape and the slide, and the event line already carries the window address.
The geometry mirrors show_panel/park_window in themis-inbox.sh — change one,
change both. A lock keeps exactly one watcher alive, so autostart can re-run
it harmlessly.
"""

import fcntl
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

MARKER = "Curation inbox · Themis · dismiss"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "themis-ui"
PANEL_CLASS = "chrome-127.0.0.1__-Default"
PANEL_W = int(os.environ.get("THEMIS_PANEL_W", "1200"))
PANEL_OFFSET_X = int(os.environ.get("THEMIS_PANEL_OFFSET_X", "-340"))
PANEL_MONITOR = os.environ.get("THEMIS_PANEL_MONITOR", "DP-3")
PARK_MARGIN = 60


def hyprctl_json(*args: str):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, timeout=5)
    return json.loads(out.stdout)


def hide(address: str) -> None:
    clients = hyprctl_json("clients")
    panel = next((c for c in clients if c.get("class") == PANEL_CLASS), None)
    if panel is None or panel["workspace"]["name"].startswith("special:"):
        return  # already parked (or gone): a stray toggle here would SHOW the overlay
    mons = hyprctl_json("monitors")
    pick = next((m for m in mons if m["name"] == PANEL_MONITOR), None) \
        or next((m for m in mons if m.get("focused")), mons[0])
    x = pick["x"] + (pick["width"] - PANEL_W) // 2 + PANEL_OFFSET_X
    park_y = max(m["y"] + m["height"] for m in mons) + PARK_MARGIN
    window = f"window = 'address:{address}'"
    # No compositor down-slide here: by the time the (coalesced, ~½s late)
    # title marker arrives, the page has already played its own exit slide
    # and the window surface is transparent — park it straight away.
    # One eval, one config tick: park, close the overlay the special-move
    # opens, re-sink the clamped window (same trick as park_window).
    subprocess.run(["hyprctl", "eval",
                    f"hl.dispatch(hl.dsp.window.move({{ workspace = 'special:themis', {window} }})); "
                    f"hl.dispatch(hl.dsp.workspace.toggle_special('themis')); "
                    f"hl.dispatch(hl.dsp.window.move({{ x = {x}, y = {park_y}, {window} }}))"],
                   capture_output=True, timeout=5)


def socket_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if signature:
        return Path(runtime) / "hypr" / signature / ".socket2.sock"
    base = Path(runtime) / "hypr"
    candidates = sorted(base.glob("*/.socket2.sock"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        raise SystemExit("no hyprland event socket found")
    return candidates[-1]


def main() -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "watchd.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another watcher is already running
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(socket_path()))
                buffer = b""
                while True:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        event = line.decode("utf-8", "replace")
                        if event.startswith("windowtitlev2>>") and event.endswith(MARKER):
                            address = event.split(">>", 1)[1].split(",", 1)[0]
                            hide(f"0x{address}")
        except OSError:
            pass
        time.sleep(2)  # compositor restarting; reconnect


if __name__ == "__main__":
    sys.exit(main())
