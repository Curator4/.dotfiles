#!/usr/bin/env python3
"""Watch Hyprland events for the Themis panel's title signals.

The curation page cannot reach the compositor, so it states requests on its
window title (app.js): a transient " · dismiss" suffix when Escape asks the
panel away, and a persistent " · drawer" suffix while the counsel drawer
wants the taller window. This daemon watches the event socket and acts
natively (shelling into themis-inbox.sh added ~500ms of interpreter
startups); the event line already carries the window address. A lock keeps
exactly one watcher alive, so autostart can re-run it harmlessly.
"""

import fcntl
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

DISMISS_SUFFIX = " · dismiss"
DRAWER_SUFFIX = " · drawer"
TITLE_PREFIX = "Curation inbox"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "themis-ui"
PANEL_W = int(os.environ.get("THEMIS_PANEL_W", "1200"))
PANEL_H = int(os.environ.get("THEMIS_PANEL_H", "706"))
PANEL_EXPANDED_H = int(os.environ.get("THEMIS_PANEL_EXPANDED_H", "1344"))
PANEL_MARGIN_TOP = int(os.environ.get("THEMIS_PANEL_MARGIN_TOP", "48"))
PANEL_MONITOR = os.environ.get("THEMIS_PANEL_MONITOR", "DP-3")


def hyprctl_json(*args: str):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, timeout=5)
    return json.loads(out.stdout)


def hide(address: str) -> None:
    # The window never leaves special:themis; hiding is closing the overlay
    # (a global toggle: it closes wherever it is open, and only opens on the
    # focused monitor when nothing is open - so never toggle blind).
    mons = hyprctl_json("monitors")
    if any(m.get("specialWorkspace", {}).get("name") == "special:themis" for m in mons):
        subprocess.run(["hyprctl", "eval",
                        "hl.dispatch(hl.dsp.workspace.toggle_special('themis'))"],
                       capture_output=True, timeout=5)


def reconcile_size(address: str, wanted: int) -> None:
    clients = hyprctl_json("clients")
    panel = next((c for c in clients if c.get("address") == address), None)
    if panel is None or panel.get("size", [0, 0])[1] == wanted:
        return
    mons = hyprctl_json("monitors")
    pick = next((m for m in mons if m["name"] == PANEL_MONITOR), None) \
        or next((m for m in mons if m.get("focused")), mons[0])
    x = pick["x"] + (pick["width"] - PANEL_W) // 2
    y = pick["y"] + PANEL_MARGIN_TOP
    # The compositor re-centers a float on resize; restate the top-dock in
    # the same config tick.
    window = f"window = 'address:{address}'"
    subprocess.run(["hyprctl", "eval",
                    f"hl.dispatch(hl.dsp.window.resize({{ x = {PANEL_W}, y = {wanted}, {window} }})); "
                    f"hl.dispatch(hl.dsp.window.move({{ x = {x}, y = {y}, {window} }}))"],
                   capture_output=True, timeout=5)


def socket_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if signature:
        return Path(runtime) / "hypr" / signature / ".socket2.sock"
    base = Path(runtime) / "hypr"
    candidates = sorted(base.glob("*/.socket2.sock"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        raise SystemExit("no hyprland event socket found")
    return candidates[-1]


def main() -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "watchd.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another watcher is already running
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(socket_path()))
                buffer = b""
                while True:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        event = line.decode("utf-8", "replace")
                        if not event.startswith("windowtitlev2>>"):
                            continue
                        payload = event.split(">>", 1)[1]
                        address, _, title = payload.partition(",")
                        if not title.startswith(TITLE_PREFIX):
                            continue
                        if title.endswith(DISMISS_SUFFIX):
                            hide(f"0x{address}")
                        else:
                            wanted = PANEL_EXPANDED_H if DRAWER_SUFFIX in title else PANEL_H
                            reconcile_size(f"0x{address}", wanted)
                            # A curation mutation reloads the page, which
                            # resets the title — refresh the waybar count so
                            # it never shows candidates that were just decided.
                            subprocess.run(["pkill", "-RTMIN+9", "waybar"],
                                           capture_output=True, timeout=5)
        except OSError:
            pass
        time.sleep(2)  # compositor restarting; reconnect


if __name__ == "__main__":
    sys.exit(main())
