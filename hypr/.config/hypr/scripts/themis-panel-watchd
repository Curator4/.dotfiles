#!/usr/bin/env python3
"""Watch Hyprland events for the Themis panel's dismiss signal.

The curation page cannot reach the compositor, so pressing Escape with
nothing open appends " · dismiss" to its title for a moment (app.js). This
daemon watches the compositor's event socket for that marker and puts the
panel away. The hide is performed natively rather than through
themis-inbox.sh: the script's bash+python startup added ~500ms between
Escape and the slide, and the event line already carries the window address.
A lock keeps exactly one watcher alive, so autostart can re-run
it harmlessly.
"""

import fcntl
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

MARKER = "Curation inbox · Themis · dismiss"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "themis-ui"


def hyprctl_json(*args: str):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, timeout=5)
    return json.loads(out.stdout)


def hide(address: str) -> None:
    # The window never leaves special:themis; hiding is closing the overlay
    # (a global toggle: it closes wherever it is open, and only opens on the
    # focused monitor when nothing is open - so never toggle blind).
    mons = hyprctl_json("monitors")
    if any(m.get("specialWorkspace", {}).get("name") == "special:themis" for m in mons):
        subprocess.run(["hyprctl", "eval",
                        "hl.dispatch(hl.dsp.workspace.toggle_special('themis'))"],
                       capture_output=True, timeout=5)


def socket_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if signature:
        return Path(runtime) / "hypr" / signature / ".socket2.sock"
    base = Path(runtime) / "hypr"
    candidates = sorted(base.glob("*/.socket2.sock"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        raise SystemExit("no hyprland event socket found")
    return candidates[-1]


def main() -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "watchd.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another watcher is already running
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(socket_path()))
                buffer = b""
                while True:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        event = line.decode("utf-8", "replace")
                        if event.startswith("windowtitlev2>>") and event.endswith(MARKER):
                            address = event.split(">>", 1)[1].split(",", 1)[0]
                            hide(f"0x{address}")
        except OSError:
            pass
        time.sleep(2)  # compositor restarting; reconnect


if __name__ == "__main__":
    sys.exit(main())
