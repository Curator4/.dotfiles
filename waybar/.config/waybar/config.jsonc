{
    "layer": "top",
    "position": "top",
    "height": 26,
    "output": ["DP-2"],

    "modules-left": ["hyprland/workspaces", "custom/theme"],
    "modules-center": ["clock"],
    "modules-right": ["custom/codexbar-claude", "custom/codexbar-codex", "custom/codexbar-grok", "custom/codexbar-openrouter", "custom/volume", "bluetooth", "custom/network", "custom/gpu", "custom/vram", "cpu", "memory", "custom/disk"],

    "custom/codexbar-codex": {
        "exec": "CODEXBAR_PROVIDERS=codex CODEXBAR_BAR_PROVIDER=codex $HOME/.config/waybar/scripts/codexbar.sh | jq -c '.text |= (gsub(\"🤖 ?\";\"\"))'",
        "return-type": "json",
        "format": "{}",
        "interval": 180,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/codexbar-popup.py",
        "tooltip": true,
        "max-length": 28
    },

    "custom/codexbar-claude": {
        "exec": "CODEXBAR_PROVIDERS=claude CODEXBAR_BAR_PROVIDER=claude $HOME/.config/waybar/scripts/codexbar.sh | jq -c '.text |= (gsub(\"🤖 ?\";\"\"))'",
        "return-type": "json",
        "format": "{}",
        "interval": 180,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/codexbar-popup.py",
        "tooltip": true,
        "max-length": 28
    },

    "custom/codexbar-openrouter": {
        "exec": "$HOME/.config/waybar/scripts/openrouter.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 180,
        "signal": 8,
        "tooltip": true,
        "max-length": 18
    },

    "custom/codexbar-grok": {
        "exec": "CODEXBAR_PROVIDERS=grok CODEXBAR_BAR_PROVIDER=grok $HOME/.config/waybar/scripts/codexbar.sh | jq -c '.text |= (gsub(\"🤖 ?\";\"\"))'",
        "return-type": "json",
        "format": "{}",
        "interval": 180,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/codexbar-popup.py",
        "tooltip": true,
        "max-length": 28
    },

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{id}",
        "sort-by": "number",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
            "7": [],
            "8": [],
            "9": []
        }
    },

    "clock": {
        "format": "{:%a %d %b · %H:%M}",
        "tooltip-format": "{:%A %d %B · W%V %Y}"
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 5,
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "󰂲 Off",
        "format-off": "󰂲 Off",
        "format-on": "󰂯 On",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
    },

    "custom/volume": {
        "exec": "~/.config/waybar/scripts/volume.sh",
        "return-type": "json",
        "restart-interval": 2,
        "on-click": "flatpak run com.saivert.pwvucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "~/.config/waybar/scripts/volume.sh up",
        "on-scroll-down": "~/.config/waybar/scripts/volume.sh down"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}",
        "on-click": "kitty -e btop"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty -e watch -n 1 nvidia-smi"
    },

    "custom/vram": {
        "exec": "~/.config/waybar/scripts/vram.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty -e watch -n 1 nvidia-smi"
    },

    "memory": {
        "interval": 5,
        "format": "RAM {percentage}%",
        "tooltip-format": "RAM Usage: {percentage}%\nUsed: {used:0.1f} GiB / {total:0.1f} GiB\nSwap: {swapPercentage}%",
        "on-click": "kitty -e btop"
    },

    // df semantics via disk.sh — the built-in module counts the ext4 root
    // reserve as free, reading ~5% lower than df/aegis/disk-space-check.
    "custom/disk": {
        "interval": 30,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/disk.sh",
        "format": "DISK {}",
        "on-click": "kitty -e btop"
    },

    "custom/theme": {
        "exec": "~/.config/waybar/scripts/theme-display.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/theme-menu.sh",
        "format": "{}",
        "tooltip": true
    }

    // "battery": {
    //     "format": "{capacity}% {icon}",
    //     "format-discharging": "{icon}",
    //     "format-charging": "{icon}",
    //     "format-plugged": "",
    //     "format-icons": {
    //         "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    //         "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    //     },
    //     "format-full": "󰂅",
    //     "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    //     "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    //     "interval": 5,
    //     "states": {
    //         "warning": 20,
    //         "critical": 10
    //     }
    // }
}
