    (4, "Ctrl"),
    (8, "Alt"),
    (1, "Shift"),
    (16, "Mod2"),
    (32, "Mod3"),
    (128, "Mod5"),
)

KEY_NAMES = {
    "Caps_Lock": "Caps",
    "grave": "Caps",
