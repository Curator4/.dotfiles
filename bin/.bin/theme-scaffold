def write_theme_dir(
    *,
    slug: str,
    name: str,
    icon: str,
    roles: dict[str, RGB],
    wallpaper: str | None,
    source_note: str,
    force: bool,
) -> Path:
    out = THEMES_DIR / slug
    if out.exists() and not force:
        raise FileExistsError(
            f"theme already exists: {out} (pass --force to overwrite draft files)"
        )
    out.mkdir(parents=True, exist_ok=True)

    theme = build_theme_json(
        name=name,
        slug=slug,
        icon=icon,
        roles=roles,
        wallpaper=wallpaper,
        source_note=source_note,
    )
    (out / "theme.json").write_text(json.dumps(theme, indent=2) + "\n", encoding="utf-8")
    write_kitty(out / "kitty.conf", name, roles)
    write_hyprland_lua(out / "hyprland.lua", name, roles)
    write_mako(out / "mako.conf", name, roles)
    write_starship(out / "starship.toml", name, roles)
    write_readme(out / "DRAFT.md", slug, source_note)

    # legacy placeholders some tools expect in the dir
    (out / "waybar.css").write_text(
        f"/* {name} — waybar is rendered on apply by theme-render.sh */\n",
        encoding="utf-8",
    )
    (out / "hyprlock.conf").write_text(
        f"# {name} — hyprlock is rendered on apply by theme-render.sh\n",
        encoding="utf-8",
    )
    return out


def print_summary(out: Path, roles: dict[str, RGB]) -> None:
    ratio = contrast_ratio(roles["foreground"], roles["background"])
    print(f"Draft theme written: {out}")
    print(f"  bg={roles['background'].hex()}  fg={roles['foreground'].hex()}  "
          f"accent={roles['accent'].hex()}  contrast={ratio:.2f}:1")
    print("  files: theme.json kitty.conf hyprland.lua mako.conf starship.toml DRAFT.md")
    print(f"  next: theme-lint {out.name} && edit wallpapers/nvim, then "
          f"theme-switcher.sh apply {out.name}")


# --- CLI -------------------------------------------------------------------


def cmd_wallpaper(args: argparse.Namespace) -> int:
    image = expand_path(args.image)
    slug = slugify(args.name or image.stem)
    name = args.display_name or title_from_slug(slug)
    icon = args.icon or "🎨"

    pixels = sample_pixels(image)
    colors = median_cut(pixels, max_colors=12)
    roles = palette_from_colors(colors, prefer_dark=not args.light)
    wallpaper = path_for_wallpaper(image)

    out = write_theme_dir(
        slug=slug,
        name=name,
        icon=icon,
        roles=roles,
        wallpaper=wallpaper,
        source_note=f"wallpaper:{wallpaper}",
        force=args.force,
    )
    print_summary(out, roles)
    return 0


def cmd_base16(args: argparse.Namespace) -> int:
    display, b16 = load_base16(args.scheme)
    roles = roles_from_base16(b16)
    # ensure AA on fg/bg (some schemes are decorative)
    fg, bg = ensure_contrast(roles["foreground"], roles["background"], 4.5)
    roles["foreground"] = fg
    roles["background"] = bg

    slug = slugify(args.name or display)
    name = args.display_name or display
    icon = args.icon or "📦"

    out = write_theme_dir(
        slug=slug,
        name=name,
        icon=icon,
        roles=roles,
        wallpaper=None,
        source_note=f"base16:{args.scheme}",
        force=args.force,
    )
    print_summary(out, roles)
    print("  note: set real wallpapers in theme.json before apply (placeholders present)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="theme-scaffold",
        description="Draft a theme from a wallpaper or Base16 scheme (authoring only).",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--name", help="theme slug (default: from source name)")
    common.add_argument("--display-name", help="pretty name in theme.json")
    common.add_argument("--icon", help="emoji icon for theme.json")
    common.add_argument("--force", action="store_true", help="overwrite existing theme dir files")

    w = sub.add_parser("wallpaper", parents=[common], help="extract palette from an image")
    w.add_argument("image", help="path to wallpaper image")
    w.add_argument("--light", action="store_true", help="prefer a light background")
    w.set_defaults(func=cmd_wallpaper)

    b = sub.add_parser("base16", parents=[common], help="import a Base16 scheme")
    b.add_argument(
        "scheme",
        help="scheme name (tinted-theming), local YAML path, or URL",
    )
    b.set_defaults(func=cmd_base16)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except (FileExistsError, FileNotFoundError, RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
