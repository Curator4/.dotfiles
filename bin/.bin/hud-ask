#!/usr/bin/env python3
"""Named capture/edit card.

Layer-shell OVERLAY, on-demand keyboard. Exclusive grab ate mouse selection
in other windows; on-demand + follow_mouse=1 left the card unfocused because
keys follow the cursor. For the life of the card we set follow_mouse=2
(click-to-focus) so Super+Y keeps keys until you click another window to
highlight/copy. stdout is the typed text; cancel exits 1.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

CARD_W = 460
THEME_SCSS = Path.home() / ".config/eww/theme-colors.scss"


def theme_tokens() -> dict[str, str]:
    tokens = {
        "bg": "rgba(8, 9, 11, 0.92)",
        "border": "rgba(62, 111, 168, 0.18)",
        "fg": "#B4BAC2",
        "muted": "#3C4558",
        "accent": "#3E6FA8",
        "hover": "rgba(62, 111, 168, 0.12)",
        "font": "JetBrainsMono Nerd Font",
    }
    if not THEME_SCSS.is_file():
        return tokens
    for line in THEME_SCSS.read_text(encoding="utf-8").splitlines():
        m = re.match(r"\$hud-(\w+):\s*(.+);\s*$", line)
        if m:
            val = m.group(2).strip()
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            tokens[m.group(1)] = val
    return tokens


def focused_monitor() -> dict:
    try:
        mons = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
    except (OSError, json.JSONDecodeError, subprocess.CalledProcessError):
        return {}
    for m in mons:
        if m.get("focused"):
            return m
    return mons[0] if mons else {}


def gdk_monitor_for(mon: dict) -> Gdk.Monitor | None:
    display = Gdk.Display.get_default()
    if display is None:
        return None
    hx, hy = int(mon.get("x", 0)), int(mon.get("y", 0))
    n = display.get_n_monitors()
    for i in range(n):
        g = display.get_monitor(i).get_geometry()
        if g.x == hx and g.y == hy:
            return display.get_monitor(i)
    return display.get_primary_monitor()


def _hypr_eval(code: str) -> None:
    subprocess.run(["hyprctl", "eval", code], check=False, capture_output=True)


def _follow_mouse() -> int:
    try:
        data = json.loads(
            subprocess.check_output(["hyprctl", "getoption", "input:follow_mouse", "-j"])
        )
        return int(data.get("int", 1))
    except (OSError, json.JSONDecodeError, subprocess.CalledProcessError, ValueError):
        return 1


def _set_follow_mouse(n: int) -> None:
    _hypr_eval(f"hl.config({{ input = {{ follow_mouse = {int(n)} }} }})")


def css_text(t: dict[str, str]) -> str:
    return f"""
window {{
  background-color: transparent;
}}
.kicker {{
  color: {t["accent"]};
  font-family: "{t["font"]}";
  font-size: 14px;
  letter-spacing: 3px;
  padding: 0 0 7px 4px;
}}
.card {{
  background-color: {t["bg"]};
  border: 1px solid {t["border"]};
  border-radius: 16px;
  padding: 12px;
}}
entry {{
  background-color: {t.get("hover", t["bg"])};
  color: {t["fg"]};
  caret-color: {t["accent"]};
  font-family: "{t["font"]}";
  font-size: 15px;
  border: 1px solid {t["border"]};
  border-radius: 10px;
  padding: 8px 12px;
  min-height: 20px;
}}
"""


class Ask:
    def __init__(self, title: str, placeholder: str, prefill: str) -> None:
        self.result: str | None = None
        self._done = False
        self._cancelled = False
        self._follow_prev = 1
        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_decorated(False)
        self.win.set_resizable(False)
        self.win.set_app_paintable(True)
        self.win.set_name("hud-ask")
        visual = self.win.get_screen().get_rgba_visual()
        if visual is not None:
            self.win.set_visual(visual)

        GtkLayerShell.init_for_window(self.win)
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self.win, "hud-ask")
        GtkLayerShell.set_exclusive_zone(self.win, 0)
        # Exclusive is a seat grab: you cannot highlight other windows.
        # On-demand + follow_mouse=2 (set for this card's lifetime) keeps
        # keys on the card until a click elsewhere.
        GtkLayerShell.set_keyboard_mode(
            self.win, GtkLayerShell.KeyboardMode.ON_DEMAND
        )

        mon = focused_monitor()
        gdk_mon = gdk_monitor_for(mon) if mon else None
        if gdk_mon is not None:
            GtkLayerShell.set_monitor(self.win, gdk_mon)
        self._place(mon, height=96)

        t = theme_tokens()
        provider = Gtk.CssProvider()
        provider.load_from_data(css_text(t).encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        kicker = Gtk.Label(label=f"● {title}" if title else "●", xalign=0)
        kicker.get_style_context().add_class("kicker")
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.get_style_context().add_class("card")

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text(placeholder)
        self.entry.set_width_chars(32)
        if prefill:
            self.entry.set_text(prefill)
            self.entry.set_position(-1)
        self.entry.connect("activate", self._accept)
        card.pack_start(self.entry, True, True, 0)

        outer.pack_start(kicker, False, False, 0)
        outer.pack_start(card, True, True, 0)
        outer.set_size_request(CARD_W, -1)
        self.win.add(outer)

        self.win.connect("key-press-event", self._on_key)
        self.win.connect("destroy", self._cancel)
        self.win.connect("map-event", self._on_map)

    def _place(self, mon: dict, height: int) -> None:
        mw = int(mon.get("width") or 1920)
        mh = int(mon.get("height") or 1080)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(
            self.win, GtkLayerShell.Edge.LEFT, max(0, (mw - CARD_W) // 2)
        )
        GtkLayerShell.set_margin(
            self.win, GtkLayerShell.Edge.TOP, max(0, (mh - height) // 2)
        )

    def _on_map(self, *_args) -> bool:
        # Brief exclusive to take keys on map, then on-demand so the
        # pointer is free. follow_mouse=2 stops hover from stealing them.
        GtkLayerShell.set_keyboard_mode(
            self.win, GtkLayerShell.KeyboardMode.EXCLUSIVE
        )
        self.entry.grab_focus()
        GLib.timeout_add(50, self._release_grab)
        return False

    def _release_grab(self) -> bool:
        GtkLayerShell.set_keyboard_mode(
            self.win, GtkLayerShell.KeyboardMode.ON_DEMAND
        )
        self.entry.grab_focus()
        return False

    def _on_key(self, _w, event) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self._cancel()
            return True
        return False

    def _finish(self, text: str | None) -> None:
        if self._done:
            return
        self._done = True
        self._cancelled = text is None
        self.result = text or ""
        _set_follow_mouse(self._follow_prev)
        self.win.hide()
        Gtk.main_quit()

    def _accept(self, *_args) -> None:
        self._finish(self.entry.get_text())

    def _cancel(self, *_args) -> None:
        self._finish(None)

    def run(self) -> int:
        self._follow_prev = _follow_mouse()
        _set_follow_mouse(2)

        def _restore_and_die(_signum, _frame) -> None:
            _set_follow_mouse(self._follow_prev)
            os._exit(1)

        signal.signal(signal.SIGTERM, _restore_and_die)
        signal.signal(signal.SIGINT, _restore_and_die)
        self.win.show_all()
        Gtk.main()
        _set_follow_mouse(self._follow_prev)
        if self._cancelled or self.result is None:
            return 1
        sys.stdout.write(self.result + "\n")
        return 0


def _close_others() -> None:
    me = os.getpid()
    pids: list[int] = []
    for name in os.listdir("/proc"):
        if not name.isdigit() or int(name) == me:
            continue
        try:
            args = open(f"/proc/{name}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        decoded = [a.decode("utf-8", "replace") for a in args if a]
        if (
            len(decoded) >= 2
            and decoded[0].endswith("python3")
            and decoded[1].endswith("/hud-ask")
        ):
            pids.append(int(name))
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + 0.4
    for pid in pids:
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.02)


def main() -> int:
    _close_others()
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--title", default=None)
    p.add_argument("--placeholder", default=None)
    p.add_argument("title_pos", nargs="?", default="")
    p.add_argument("placeholder_pos", nargs="?", default="type something…")
    p.add_argument("-filter", "--filter", default="", dest="prefill")
    args, _unknown = p.parse_known_args()
    title = args.title if args.title is not None else args.title_pos
    placeholder = (
        args.placeholder if args.placeholder is not None else args.placeholder_pos
    )
    return Ask(title, placeholder, args.prefill).run()


if __name__ == "__main__":
    sys.exit(main())
