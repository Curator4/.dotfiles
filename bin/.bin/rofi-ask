#!/usr/bin/env bash
# Text-only named card. stdout: what was typed.
# The first arg names the card, the optional second arg is the field hint.
# Remaining args: -filter TEXT prefills (edit). Other rofi flags are ignored.
#
#   note=$(rofi-ask 'backlog' 'add something…') || exit 0
set -euo pipefail

title=${1:-}
if [ $# -gt 0 ]; then
    shift
fi

placeholder='type something…'
if [ $# -gt 0 ] && [[ $1 != -* ]]; then
    placeholder=$1
    shift
fi

filter=
while [ $# -gt 0 ]; do
    case $1 in
    -filter | --filter)
        filter=${2:-}
        shift 2
        ;;
    *)
        shift
        ;;
    esac
done

# gtk-layer-shell ON_DEMAND card — not rofi. Rofi's exclusive seat grab
# ate pointer events outside the overlay, so you could not select text
# in any other window while Super+Y was open.
ask=${HUD_ASK:-$HOME/.bin/hud-ask}
exec "$ask" --title "$title" --placeholder "$placeholder" --filter "$filter"
