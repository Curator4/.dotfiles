#!/usr/bin/env bash
# Warn via mako when / or the filesystem holding $HOME is running low on space.
# Threshold is overridable for testing: DISK_WARN_THRESHOLD=10 disk-space-check
threshold=${DISK_WARN_THRESHOLD:-90}

paths=(/)
[ "$(stat -c %d "$HOME")" = "$(stat -c %d /)" ] || paths+=("$HOME")

for p in "${paths[@]}"; do
    read -r target use avail < <(df -h --output=target,pcent,avail "$p" | awk 'NR==2 {print $1, $2, $3}')
    use=${use%\%}
    if [ "$use" -ge "$threshold" ]; then
        hint=""
        command -v cache-reap >/dev/null 2>&1 && hint=$'\nrun <tt>cache-reap</tt> to clear rebuildable caches'
        notify-send -u critical "Disk space low" "${target} is ${use}% full — ${avail} free${hint}"
    fi
done
