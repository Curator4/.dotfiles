#!/usr/bin/env bash
# Super+Shift+U — show/hide the HUD. Open goes through hud-place so a running
# timer's exclusive zone does not slide the panel into the timer bar.

eww close hud-expanded >/dev/null 2>&1 || true

if eww active-windows 2>/dev/null | grep -q '^hud:'; then
  eww close hud hud-reserve >/dev/null 2>&1 || true
else
  ~/.config/eww/scripts/hud-place --open
fi
