; ── AI Companion Bar ─────────────────────────────────────
; Sits at the top of vertical monitor (DP-4, workspace 4)
; Three panels: voice indicator | avatar | dashboard

; ── Variables ────────────────────────────────────────────
(defvar vibe "cyber")
(defvar avatar_image "/home/curator/.claude/vibes/cyber/avatar.jpg")
(defvar speaking false)
(defvar thinking false)
(defvar thinking_stage "")
(defvar current_voice "mustang")
(defvar last_tool "")
(defvar session_active false)

; ── Polling variables ────────────────────────────────────
(defpoll vibe_poll :interval "2s"
  `cat ~/.claude/current-vibe 2>/dev/null || echo "chill"`)

(defpoll voice_poll :interval "2s"
  `cat ~/workspace/ai/tts-daemon/voice.txt 2>/dev/null || echo "unknown"`)

(defpoll speaking_poll :interval "300ms"
  `~/.config/eww/scripts/tts-speaking`)

(defpoll thinking_poll :interval "1s"
  `[ -f /tmp/tts-daemon/thinking-stage ] && cat /tmp/tts-daemon/thinking-stage || echo ""`)

(defpoll session_poll :interval "2s"
  `pgrep -f "claude" >/dev/null 2>&1 && echo true || echo false`)

; ── Voice Indicator (left panel) ─────────────────────────
(defwidget voice-indicator []
  (box :class "voice-panel"
       :orientation "v"
       :valign "center"
       :halign "center"
       :space-evenly false
    ; Pulsing orb when speaking
    (box :class "orb-container"
      (box :class {speaking_poll == "true" ? "orb speaking" : "orb idle"}))
    ; Status text
    (label :class "voice-status"
           :text {speaking_poll == "true" ? "speaking" :
                  thinking_poll != "" ? "thinking" : "listening"})
    ; Voice name
    (label :class "voice-name" :text voice_poll)))

; ── Avatar (center panel) ────────────────────────────────
(defwidget avatar []
  (box :class "avatar-panel"
       :orientation "v"
       :valign "center"
       :halign "center"
       :space-evenly false
    (image :path {"/home/curator/.claude/vibes/${vibe_poll}/avatar.jpg"}
           :image-width 280
           :image-height 280)
    (label :class "vibe-name" :text vibe_poll)))

; ── Dashboard (right panel) ──────────────────────────────
(defwidget dashboard []
  (box :class "dashboard-panel"
       :orientation "v"
       :valign "center"
       :halign "center"
       :space-evenly false
    ; Session status
    (box :class "dash-row"
      (label :class "dash-label" :text "session")
      (label :class "dash-value"
             :text {session_poll == "true" ? "active" : "idle"}))
    ; Current vibe
    (box :class "dash-row"
      (label :class "dash-label" :text "vibe")
      (label :class "dash-value" :text vibe_poll))
    ; Current voice
    (box :class "dash-row"
      (label :class "dash-label" :text "voice")
      (label :class "dash-value" :text voice_poll))
    ; Time
    (box :class "dash-row"
      (label :class "dash-label" :text "time")
      (label :class "dash-value" :text {formattime(EWW_TIME, "%H:%M")}))))

; ── Main Bar ─────────────────────────────────────────────
(defwidget ai-bar []
  (box :class "ai-bar"
       :orientation "v"
       :space-evenly false
    (avatar)
    (voice-indicator)
    (dashboard)))

; ── Window ───────────────────────────────────────────────
(defwindow ai-companion
  :monitor "DP-4"
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "1420px"
                      :height "600px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "ai-companion"
  (ai-bar))

; ═════════════════════════════════════════════════════════
; ── Themed Timer Bar (top of DP-4, reserves space) ───────
; State source of truth: /tmp/eww-timer/end (epoch seconds).
; Poll script: ~/.config/eww/scripts/timer-state
; Driver:      ~/.config/fish/functions/timer.fish
; ═════════════════════════════════════════════════════════

; Poll the state once, then read each field from the parsed JSON object.
(defpoll timer_state :interval "200ms"
  :initial '{"display":"0:00","msg":"","progress":0,"phase":"idle","color":"red"}'
  `~/.config/eww/scripts/timer-state`)

(defwidget timer-bar []
  (box :class "timer-bar timer-c-${timer_state.color} timer-p-${timer_state.phase}"
       :orientation "v"
       :space-evenly false
       :spacing 0
    (centerbox :class "timer-row" :orientation "h"
      (label :class "timer-time" :text {timer_state.display} :halign "start" :valign "center")
      (box)
      (label :class "timer-msg"  :text {timer_state.msg} :halign "end" :valign "center"
             :visible {strlength(timer_state.msg) > 0}))
    (progress :class "timer-progress"
              :value {timer_state.progress}
              :orientation "h")))

(defwindow timer
  :monitor "DP-4"
  :geometry (geometry :x "0px" :y "0px" :width "1440px" :height "140px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "timer"
  (timer-bar))

; ═════════════════════════════════════════════════════════
; ── Household HUD — focus board (two columns) ────────────
; Project groups packed across two columns by height (`hud board` picks the
; break) — your FOCUS, with live Claude Code activity painted on as an animated
; spinner + drift badges. Every item lives under its project; reading order is
; work, then declared projects in focus.md order, then auto-revealed ones.
; Each zone is a for-loop of rows from hud-column-json (polled fast so the
; spinner animates). (backlog zone exists in `hud board` but is off the panel.)
;
; Focus clicks (same address scheme as TODAY — 1-based index left-then-right):
;   left-click item  → focus-done   (archive + drop)
;   right-click item → focus-remove (drop, no archive)
;   right-click header → rofi free-text → focus-add under that project
; eww has no modifier-click handlers, so right-click stands in for ctrl-click.
;
; TODAY strip: the council's day plan (itinerary zone), one clickable row per
; item — click flips it via `hud itinerary-toggle <n>` and drops the board cache
; so the ✓ shows on the next poll. Toggle, not `itinerary-done`: a mis-tap on an
; always-on panel needs the same tap to undo it, and the row is the only place
; that undo can live. The conversational surfaces keep the idempotent `done`.
;
; Footer row, below the columns and deliberately unlike a focus item — checks
; left, caffeine + posture right, all small and dim until they have a reason
; not to be.
;
; Checks: what's still due on the routine registry, named one item at a time
; (`hud checks render`). The full list stays behind Super+X, which is good at
; acking; the footer only owes the reminder that a list exists. It names the
; oldest item and counts the rest, and reddens as that item ages — a block that
; renders identically every morning is furniture by day three, which is how the
; pull-only menu failed. Click opens the same rofi ack menu the keybind does.
;
; Caffeine: today's total mg, estimated active mg (5h half-life), quiet-after
; clock. Sits next to posture as the other body instrument. `hud caffeine
; render` paints amber past the soft daily cap. Click opens the same rofi
; picker Super+Shift+X runs.
;
; Posture: declared sit/stand time with away-from-desk subtracted (the AFK
; stream from ActivityWatch). Instrumentation, not agenda. `hud posture render`
; paints it amber past the nudge threshold. Click flips sit/stand — the same
; `hud posture toggle` Super+R runs, so the footer you're already reading when
; the nudge lands is somewhere you can answer it.
; ═════════════════════════════════════════════════════════
(defpoll board_left     :interval "150ms" :initial "[]" `~/.config/eww/scripts/hud-column-json left`)
(defpoll board_right    :interval "150ms" :initial "[]" `~/.config/eww/scripts/hud-column-json right`)
(defpoll board_today    :interval "2s"    :initial "[]" `~/.config/eww/scripts/hud-today-json`)
(defpoll board_caffeine :interval "2s"    :initial ""   `~/.config/eww/scripts/hud-caffeine-render`)
(defpoll board_posture  :interval "2s"    :initial ""   `~/.config/eww/scripts/hud-posture-render`)
; Slow: this one shells out to python3, and a routine item's state moves in hours.
(defpoll board_checks   :interval "30s"   :initial ""   `~/.config/eww/scripts/hud-checks-render`)

; One column of the focus board: per-row eventboxes so items and headers can
; take clicks. Markup is pre-painted (project colour + spinner) by the poll
; script; non-action rows still sit in an eventbox so spacing matches, with a
; no-op shell and the default cursor.
(defwidget hud-zone [class rows]
  (box :class "hud-zone ${class}" :orientation "v" :space-evenly false :hexpand true :valign "start"
    (for row in rows
      (eventbox :cursor {row.item || row.header ? "pointer" : "default"}
                :onclick {row.item ?
                  "/home/curator/workspace/hud/hud focus-done ${row.i} >/dev/null 2>&1; rm -f ~/.local/state/hud/board.json &"
                  : "true"}
                :onrightclick {row.item ?
                  "/home/curator/workspace/hud/hud focus-remove ${row.i} >/dev/null 2>&1; rm -f ~/.local/state/hud/board.json &"
                  : row.header ?
                  "~/.config/eww/scripts/hud-focus-add ${row.project} &"
                  : "true"}
        (label :class "hud-body" :markup {row.markup} :halign "start" :wrap false)))))

(defwidget hud-today []
  (box :class "hud-today" :orientation "v" :space-evenly false
       :visible {arraylength(board_today) > 0}
    (label :class "today-header" :text "TODAY" :halign "start")
    (for it in board_today
      (eventbox :cursor "pointer"
                :onclick "/home/curator/workspace/hud/hud itinerary-toggle ${it.i} >/dev/null 2>&1; rm -f ~/.local/state/hud/board.json &"
        (label :class {it.done ? "today-item done" : "today-item"}
               :halign "start"
               :text "${it.done ? "✓" : "○"}  ${it.text}")))))

(defwidget hud-footer []
  (box :class "hud-footer" :orientation "h" :space-evenly false
       :visible {board_checks != "" || board_caffeine != "" || board_posture != ""}
    (eventbox :cursor "pointer" :hexpand true :halign "start"
              :visible {board_checks != ""}
              :onclick "/home/curator/workspace/ai/household-oc/tools/checks/checks-menu.sh &"
      (label :class "checks-line" :markup board_checks :halign "start"))
    (box :orientation "h" :space-evenly false :spacing 10
         :hexpand true :halign "end"
      (eventbox :cursor "pointer"
                :visible {board_caffeine != ""}
                :onclick "~/.config/hypr/scripts/caffeine-menu.sh &"
        (label :class "caffeine-line" :markup board_caffeine :halign "end"))
      (label :class "instrument-sep"
             :visible {board_caffeine != "" && board_posture != ""}
             :text "│")
      (eventbox :cursor "pointer"
                :visible {board_posture != ""}
                :onclick "/home/curator/workspace/hud/hud posture toggle >/dev/null 2>&1 &"
        (label :class "posture-line" :markup board_posture :halign "end")))))

(defwidget hud-panel []
  (box :class "hud-panel" :orientation "v" :space-evenly false :spacing 10
    (hud-today)
    (box :orientation "h" :space-evenly true :spacing 40
      (hud-zone :class "zone-left"  :rows board_left)
      (hud-zone :class "zone-right" :rows board_right))
    (hud-footer)))
(defwindow hud
  :monitor "DP-4"
  :geometry (geometry :x "0px" :y "0px" :width "1440px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "hud"
  (hud-panel))
