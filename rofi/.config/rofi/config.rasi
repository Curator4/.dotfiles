configuration {
    modi: "drun,ssh";
    show-icons: true;
    display-drun: "Apps";
    display-ssh: "SSH";
    drun-display-format: "{name}";
    font: "Hack Nerd Font 12";
    sorting-method: "fzf";
    matching: "fuzzy";
    /* -1 = currently focused monitor. Hardcoding DP-2 parked every picker
       on the top display even when focus was on DP-3/DP-4. */
    monitor: "-1";
    /* Bare j/k are always text; Ctrl+j/k move an active picker row. This
       permits filtering a list for words such as "jira" while retaining
       keyboard navigation. Return or Ctrl+m accepts an entry. */
    kb-row-up: "Up,Control+p,Control+k";
    kb-row-down: "Down,Control+n,Control+j";
    kb-remove-to-eol: "";
    kb-accept-entry: "Control+m,Return,KP_Enter";
    /* Rofi's default Control+V (the shifted chord) pastes PRIMARY, not
       the clipboard. Kitty's paste is Ctrl+Shift+V, so Super+Y looks like
       a dead clipboard after a yank or a browser copy. Both chords paste
       CLIPBOARD; Shift+Insert keeps PRIMARY. */
    kb-primary-paste: "Shift+Insert";
    kb-secondary-paste: "Control+v,Control+V,Insert";
    kb-secondary-copy: "Control+c,Control+C";
}

/* current.rasi is generated by theme-render.sh (colors + @import "card.rasi"). */
@theme "current"
