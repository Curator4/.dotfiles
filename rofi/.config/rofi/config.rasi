configuration {
    modi: "drun,ssh";
    show-icons: true;
    display-drun: "Apps";
    display-ssh: "SSH";
    drun-display-format: "{name}";
    font: "Hack Nerd Font 12";
    sorting-method: "fzf";
    matching: "fuzzy";
    /* -1 = currently focused monitor. Hardcoding DP-2 parked every picker
       on the top display even when focus was on DP-3/DP-4. */
    monitor: "-1";
    /* Bare j/k are always text; Ctrl+j/k move an active picker row. This
       permits filtering a list for words such as "jira" while retaining
       keyboard navigation. Return or Ctrl+m accepts an entry. */
    kb-row-up: "Up,Control+p,Control+k";
    kb-row-down: "Down,Control+n,Control+j";
    kb-remove-to-eol: "";
    kb-accept-entry: "Control+m,Return,KP_Enter";
}

/* current.rasi is generated by theme-render.sh (colors + @import "card.rasi"). */
@theme "current"
