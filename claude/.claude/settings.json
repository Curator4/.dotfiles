      "Bash(systemctl --user:*)",
      "Bash(pw-link:*)",
      "Bash(wpctl:*)",
      "Bash(wc:*)",
      "Bash(go:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(docker:*)",
      "Bash(podman:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tar:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(eza:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(fzf:*)",
      "Bash(tee:*)",
      "Bash(diff:*)",
      "Bash(patch:*)",
      "Bash(wt:*)",
      "Bash(herdr:*)",
      "Bash(hud:*)",
      "Bash(xdg-open:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:github.com)",
      "Bash(bluetoothctl devices:*)",
      "Bash(test:*)",
      "Bash(wf-recorder:*)",
      "Bash(catt:*)",
      "Bash(~/.bin/cast-monitor:*)",
      "WebFetch(domain:ffmpeg.org)",
      "WebFetch(domain:www.martin-riedl.de)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:fossies.org)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:patchwork.ffmpeg.org)",
      "WebFetch(domain:manpages.ubuntu.com)",
      "WebFetch(domain:www.hackitu.de)",
      "WebFetch(domain:linderud.dev)",
      "Bash(command -v:*)",
      "WebFetch(domain:publish.obsidian.md)",
      "WebFetch(domain:forum.obsidian.md)",
      "WebFetch(domain:www.obsidianstats.com)",
      "Bash(source bin/activate)",
      "Bash(/usr/bin/ls -lt ~/.claude/projects/-home-curator/*.jsonl)",
      "Read(//tmp/**)",
      "Bash(gh repo:*)",
      "mcp__claude_ai_Gmail__gmail_search_messages",
      "mcp__claude_ai_Google_Calendar__gcal_list_events",
      "Bash(yt-dlp:*)",
      "Bash(rm -f ~/.claude/tts-voice-mode)",
      "Bash(~/workspace/ai/tts-daemon/voice.txt)",
      "Bash(export CUDA_HOME=/opt/cuda)",
      "Bash(export NVCC_PREPEND_FLAGS='-ccbin /usr/bin/g++-13 -Xcudafe --diag_suppress=20208')",
      "Bash(pip install:*)",
      "WebFetch(domain:unsloth.ai)",
      "WebFetch(domain:ocdevel.com)",
      "WebFetch(domain:git.sr.ht)",
      "WebFetch(domain:thenextweb.com)",
      "Bash(timer:*)",
      "Bash(email-tool act:*)"
    ],
    "deny": [
      "Artifact"
    ],
    "ask": [
      "Bash(/home/curator/.claude/channels/telegram/approve-send:*)",
      "Bash(/home/curator/.local/bin/approve-send:*)",
      "Bash(approve-send:*)",
      "Bash(~/.claude/channels/telegram/approve-send:*)",
      "Bash(~/.local/bin/approve-send:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-cue-hook claude resolve",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bunx -y ccstatusline@2.2.30 --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hud-working.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hud-end.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tts-greeting.sh",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/curator/.claude/hooks/hud-marker-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/curator/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tts-finalize.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hud-focus-stop.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hud-stop.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-cue-hook claude",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-cue-hook claude request",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bunx -y ccstatusline@2.2.30 --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hud-working.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.30",
    "padding": 0
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": false,
    "codex@openai-codex": true,
    "discord@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "grok-cc@grok-plugin-claude-code": true,
    "i-have-adhd@i-have-adhd": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "household": {
      "source": {
        "source": "directory",
        "path": "/home/curator/.claude/marketplaces-local/household"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "grok-plugin-claude-code": {
      "source": {
        "source": "github",
        "repo": "zachdunn/grok-plugin-claude-code"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 1000000,
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "claudeMdExcludes": [
    "**/household-oc*/agents/*/AGENTS.md"
  ],
  "theme": "dark-ansi",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Private (github.com/Pro-Network-Consult, single-owner org, account Curator4); assume private everywhere",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: `main` on all repos; merges land via PR (`gh pr merge`). Force-pushing, deleting, or committing directly to `main` needs explicit confirmation; pushing feature/`routine/*` branches and opening PRs is normal, expected work",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: GitHub via `gh` CLI as Curator4; primary work repo /home/curator/workspace/pnc/alarm-receiver (origin github.com:Pro-Network-Consult/alarm-receiver), plus personal repos under ~/workspace and ~/.dotfiles — all trusted local clones with configured remotes",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — includes credential files noted under this home directory such as .aws/credentials, .config/gcloud/credentials.db, .openclaw/secrets.json, .hermes/.env, and similar .env / secrets files",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: professional development on the alarm-receiver repo (~/workspace/pnc/alarm-receiver) plus personal AI/household tooling; an unattended routine fleet (systemd user timer, daily 05:12) legitimately runs git worktree/commit/push and gh PR/issue operations inside that repo's .worktrees/",
      "**Trusted repo**: /home/curator/workspace/pnc/alarm-receiver with origin github.com:Pro-Network-Consult/alarm-receiver — commits and pushes scoped to it (and its .worktrees/) are routine, including from headless/unattended sessions; git operations elsewhere under /home/curator follow per-repo remotes",
      "**Org-specific CLIs**: None configured",
      "routine under curator/ prefix: not applicable — no org or namespace prefix evidenced"
    ]
  },
  "voiceEnabled": true
}
