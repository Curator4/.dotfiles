{
  "skillListingBudgetFraction": 0.012,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "SHELL": "/usr/bin/fish"
  },
  "permissions": {
    "allow": [
      "mcp__atlassian__*",
      "mcp__plugin_atlassian_atlassian__*",
      "mcp__claude_ai_Atlassian__*",
      "mcp__weather__*",
      "mcp__plugin_discord_discord__*",
      "Bash(git:*)",
      "Bash(gh:*)",
      "WebSearch",
      "Bash(golangci-lint:*)",
      "Bash(make:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
